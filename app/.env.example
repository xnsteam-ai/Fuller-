# Copy to .env.local and fill in. Never commit .env.local.
# AI: gemini (API key) | vertex (not implemented yet)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Supabase (leave blank to run on the localStorage fake data layer)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # publishable (anon) key, safe in the browser; NEXT_PUBLIC_SUPABASE_ANON_KEY also works
SUPABASE_SERVICE_ROLE_KEY=
# Monthly limits per user (mirror the original: 350 standard / 50 experimental)
QUOTA_STANDARD=350
QUOTA_EXPERIMENTAL=50
